# ==========================================
# LANGFUSE - CONFIGURAÇÕES GERAIS
# ==========================================

# URL de acesso à interface web do Langfuse
LANGFUSE_URL=http://localhost:38472

# URL pública do MinIO para acessar arquivos
MINIO_PUBLIC_URL=http://localhost:9090


# ==========================================
# SEGURANÇA
# ==========================================

# Chave utilizada para proteger as sessões de autenticação
NEXTAUTH_SECRET=langfuse_local_nextauth_secret_2026_8f3a9c2e7b1d

# Salt utilizado para operações criptográficas
SALT=langfuse_local_salt_2026_7c9e2a4f

# Chave de criptografia AES-256 (64 caracteres hexadecimais)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


# ==========================================
# POSTGRESQL
# ==========================================

# Senha do banco PostgreSQL utilizado pelo Langfuse
POSTGRES_PASSWORD=langfuse_postgres_2026


# ==========================================
# REDIS
# ==========================================

# Senha do Redis utilizado para filas e cache
REDIS_PASSWORD=langfuse_redis_2026


# ==========================================
# CLICKHOUSE
# ==========================================

# Senha do ClickHouse utilizado para armazenar traces e eventos
CLICKHOUSE_PASSWORD=langfuse_clickhouse_2026


# ==========================================
# MINIO
# ==========================================

# Senha do MinIO utilizado para armazenar arquivos e eventos
MINIO_PASSWORD=langfuse_minio_2026