# ==========================================
# AGENTE
# ==========================================

# Seleciona qual agente executar
AGENT_NAME=langchain_agent_langfuse_test

# ==========================================
# MODELOS LLM
# ==========================================

LLM_URL=http://localhost:8072/v1
LLM_MODEL=gemma4
OPENAI_API_KEY=local

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://redis:6379

# ==========================================
# LANGFUSE
# ==========================================

# Habilita/desabilita observabilidade
LANGFUSE_ENABLED=true

# Endereço do Langfuse na rede Docker
LANGFUSE_SECRET_KEY="sk-lf-10d9730d-6c3e-4f72-be50-b255c45ee5e9"
LANGFUSE_PUBLIC_KEY="pk-lf-4c43e603-6293-464c-b250-6a87ecef64dd"
LANGFUSE_BASE_URL="http://localhost:38472"

# Ambiente utilizado para identificar os traces
LANGFUSE_TRACING_ENVIRONMENT=development
