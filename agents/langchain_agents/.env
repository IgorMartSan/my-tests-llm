# ==========================================
# AGENTE
# ==========================================

# Seleciona qual agente executar
AGENT_NAME=rsa

# ==========================================
# MODELOS LLM
# ==========================================

LLM_URL=http://gemma:8000/v1
LLM_MODEL=gemma

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://redis:6379

# ==========================================
# LANGFUSE
# ==========================================

# Habilita/desabilita observabilidade
LANGFUSE_ENABLED=true

# Endereço do Langfuse na rede Docker
LANGFUSE_BASE_URL=http://langfuse-web:3000

# Credenciais geradas na interface do Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# Ambiente utilizado para identificar os traces
LANGFUSE_TRACING_ENVIRONMENT=development